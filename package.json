{
  "name": "self-heal",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "expect-webdriverio": "^6.1.0"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "test:tier0": "wdio run ./wdio.conf.ts --spec ./wdio-suite/e2e/specs/form.plain.spec.ts",
    "test:tier1": "wdio run ./wdio.conf.ts --spec ./wdio-suite/e2e/specs/form.spec.ts",
    "test:tier2": "wdio run ./wdio.conf.ts --spec ./wdio-suite/e2e/specs/form.semantic.spec.ts",
    "test:tier3": "wdio run ./wdio.conf.ts --spec ./wdio-suite/e2e/specs/shadow.spec.ts --spec ./wdio-suite/e2e/specs/canvas.spec.ts"
  }
}
